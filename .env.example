# K-Plogging Trail 환경변수 설정
# 이 파일을 .env 로 복사한 뒤, 실제 키 값을 넣으세요.
#   cp .env.example .env

# ✅ 필수 — Gemini AI (코스 설명 + 플로깅 루트 자동 생성)
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ✅ 필수 — 한국관광공사 TourAPI (근처 관광지 추천)
# 발급: https://www.data.go.kr/ → "국문 관광정보 서비스" 검색
TOUR_API_KEY=your_tour_api_key_here

# ✅ 필수 — Supabase (플로깅 기록 저장)
# 발급: https://supabase.com → 프로젝트 Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# 선택 — 카카오맵 좌표 조회 (개발용, 앱 실행에는 불필요)
# KAKAO_API_KEY=your_kakao_api_key_here
